#!/usr/bin/env python3
"""Ask the running RepoMind agent to stop at the next safe boundary."""
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from policy.stop import request

def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("run_id", help="ID printed by the live run notification")
    a = p.parse_args()
    trace = ROOT / "runs" / (a.run_id + ".jsonl")
    if not trace.is_file():
        p.error(f"run not found: {a.run_id}")
    rows = [json.loads(s) for s in trace.read_text().splitlines() if s.strip()]
    if not rows or rows[0].get("type") != "run_start":
        p.error("the run has no valid run_start")
    if any(r.get("type") == "run_end" for r in rows):
        p.error("the run has already ended; a stop cannot affect it")
    try:
        row = request(a.run_id)
    except ValueError as exc:
        p.error(str(exc))
    print(f"Stop requested for {a.run_id} at {row['at']}; waiting for the next safe boundary")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
