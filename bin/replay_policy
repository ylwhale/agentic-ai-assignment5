#!/usr/bin/env python3
"""Classify a recorded day with the same policy placement used by the live hook.

Usage: bin/replay_policy FILE [--batched] [--json]

A batched review replaces repeated approvals of covered action classes within one
run with a single plan review. It is asked before the first covered action once
the draft is known; later material plan revisions would require re-approval.
The recorded fixture has no plan revisions, so they are not included here.
"""

from __future__ import annotations

import argparse
from collections import Counter
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from policy.hook import COLUMNS, place  # noqa: E402

BUDGET_SECONDS = 600
# Both actions are represented in RepoMind's plan; the plan and exact checked
# comment draft are available before the label/PR/comment write sequence.
PLAN_REVIEW_COVERS = ("open_pr", "post_comment/human_active")


def replay(path: Path, *, batched: bool) -> dict:
    totals = {column: Counter() for column in COLUMNS}
    covered_runs = set()
    uncovered_prompts = 0

    with path.open(encoding="utf-8") as stream:
        for number, line in enumerate(stream, 1):
            if not line.strip():
                continue
            record = json.loads(line)
            action_class, column = place(record["action"], record["facts"])
            totals[column][action_class] += 1
            if column == "requires_approval" and batched:
                if action_class in PLAN_REVIEW_COVERS:
                    run_id = record.get("run_id")
                    if not run_id:
                        raise ValueError(f"line {number}: batched calls need a run_id")
                    covered_runs.add(run_id)
                else:
                    uncovered_prompts += 1

    prompts = (len(covered_runs) + uncovered_prompts if batched
               else sum(totals["requires_approval"].values()))
    result = {column: dict(sorted(totals[column].items())) for column in COLUMNS}
    result["prompts_per_day"] = prompts
    result["seconds_per_prompt"] = round(BUDGET_SECONDS / prompts, 1) if prompts else None
    if batched:
        result["covers"] = list(PLAN_REVIEW_COVERS)
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("file", type=Path, metavar="FILE", help="recorded tool calls, JSONL")
    parser.add_argument("--batched", action="store_true", help="one plan review per run for covered classes")
    parser.add_argument("--json", action="store_true", help="print only a JSON object")
    args = parser.parse_args()

    result = replay(args.file, batched=args.batched)
    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        for column in COLUMNS:
            print(f"{column}:")
            for action_class, count in result[column].items():
                print(f"  {action_class}: {count}")
        if args.batched:
            print("plan review covers:", ", ".join(result["covers"]))
        print("prompts_per_day:", result["prompts_per_day"])
        print("seconds_per_prompt:", result["seconds_per_prompt"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
