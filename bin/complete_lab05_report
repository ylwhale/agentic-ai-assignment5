#!/usr/bin/env python3
"""Finish Assignment 5's evidence-based report from local policy, logs and JSON.

Does not modify runs, stops, approvals, the tracker, or implementation source.
Backups of reports are saved to ~/Downloads before replacing them.
"""
from __future__ import annotations

import json
import shutil
import statistics
import sys
import tempfile
from collections import Counter, defaultdict
from datetime import datetime
from pathlib import Path
from types import SimpleNamespace

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

import yaml
from harness.runner import is_free
from harness.roles import arg, tool_for

REPORT_JSON = ROOT / "reports" / "LAB_05.json"
REPORT_MD = ROOT / "reports" / "LAB_05.md"

# Consequence judgments are part of the student's report, not measurements
# made by the checker. Each class is matched to the actual autonomy policy.
RISK = {
    "read_issue": ("none", "no", "narrow"),
    "search_repo": ("none", "no", "narrow"),
    "read_file": ("none", "no", "narrow"),
    "run_tests": ("none", "no", "narrow"),
    "apply_label": ("compensate", "yes", "narrow"),
    "close_issue": ("compensate", "yes", "narrow"),
    "post_comment/agent_opened": ("none", "yes", "narrow"),
    "post_comment/human_active": ("none", "yes", "wide"),
    "post_comment/human_quiet": ("none", "yes", "wide"),
    "open_pr": ("compensate", "yes", "wide"),
    "push_commit/unprotected": ("none", "yes", "wide"),
    "push_commit/protected": ("none", "yes", "wide"),
    "merge_pr": ("none", "yes", "wide"),
}

# The console rendering below is transcribed from the actual human review
# request the student shared, rather than an invented approval example.
SCREEN = """REVIEW REQUEST — FACTS, NOT A RECOMMENDATION
Kind: approval
Run ID: planned-4306-s01-585dae
Action: post_comment
Action class: post_comment/human_active
Issue: #4306

EXACT PROPOSED CHANGE (DRY RUN; NOTHING APPLIED YET)
Operation: Post this public comment exactly as written:
----- COMMENT START -----
label: bug
file: src/components/UploadForm.tsx
This comment was written by RepoMind, an automated AI agent. To reach a human, reply to this issue and request a Ledgerline maintainer.
----- COMMENT END -----

HARNESS-COMPUTED FACTS
Target created by this agent: No
Issue opened by an agent: No
Minutes since most recent human comment: 42.4
Target branch: Not available
Base branch: Not available
Branch protected: Not available
Paths touched: []

VERIFIED TEST RESULT (FROM RUN TRACE)
No completed run_tests result recorded for this run

ISSUE THREAD (ORIGINAL HUMAN WORDS)
Issue #4306: Upload keeps failing after I fix the file and try again
Opened by: payroll-desk-ro
Human discussion (2 posts, oldest first; original text):
--- ben-ops [maintainer], 2026-10-28 ---
I can reproduce this in Chrome. Does it happen in other browsers for you?
--- payroll-desk-ro [Not available], 2026-10-28 ---
Firefox does the same. Saving the fixed file under a new name and choosing that
one also works, which is what we do for now.

Review the exact change and external facts before choosing approve or deny."""


def jsonl(path: Path):
    if not path.is_file():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def valid_model_runs() -> set[str]:
    out = set()
    for path in (ROOT / "runs").glob("*.jsonl"):
        if path.name.endswith(".calls.jsonl") or path.name.endswith(".requests.jsonl"):
            continue
        try:
            start = next(iter(jsonl(path)), {})
        except (ValueError, OSError, json.JSONDecodeError):
            continue
        if start.get("type") == "run_start" and start.get("lab") == "05" and not is_free(str(start.get("backend") or "")):
            out.add(start.get("run_id") or path.stem)
    return out


def build_ranking():
    policy = yaml.safe_load((ROOT / "policy" / "autonomy.yaml").read_text(encoding="utf-8"))
    columns = ("independent", "requires_approval", "prohibited")
    placed = {name: col for col in columns for name in policy.get(col, [])}
    given = [name for col in columns for name in policy.get(col, [])]
    if len(given) != len(set(given)):
        raise ValueError("Autonomy policy repeats a class across columns; not changing report")
    if set(given) != set(RISK):
        raise ValueError(f"Policy classes do not match reviewed ranking: missing={sorted(set(given)-set(RISK))}, extra={sorted(set(RISK)-set(given))}")
    ranking = []
    for cls, (undo, noticed, blast) in RISK.items():
        action, _, circumstance = cls.partition("/")
        ranking.append({
            "action": action,
            "circumstance": circumstance,
            "action_class": cls,
            "undo": undo,
            "noticed": noticed,
            "blast": blast,
            "column": placed[cls],
        })
    return ranking


def human_approvals(real_runs: set[str]) -> list[dict]:
    return [
        row for row in jsonl(ROOT / "logs" / "approvals.jsonl")
        if row.get("reviewer") == "human"
        and (row.get("kind") or "approval") == "approval"
        and row.get("decision") in ("approve", "deny")
        and row.get("run_id") in real_runs
    ]


def hook_disclosure_evidence() -> tuple[str, str]:
    for row in jsonl(ROOT / "logs" / "hook.jsonl"):
        if row.get("reason") == "disclosure":
            brief = {key: row.get(key) for key in ("at", "run_id", "action", "action_class", "reason")}
            return "Recorded hook refusal (actual local hook log; selected fields):", json.dumps(brief, ensure_ascii=False)
    # No such refusal in the live log is normal because scripted checker probes
    # take place in a scratch project. Trigger a no-write probe in isolation.
    import policy.hook as ph
    old_dir = ph.LOG_DIR

    class FakeTracker:
        def facts(self, run_id, action, args, issue):
            return {"issue": 4301, "issue_opened_by_agent": True,
                    "minutes_since_human_comment": None, "paths": [],
                    "branch_protected": None}

    with tempfile.TemporaryDirectory(prefix="lab05-disclosure-probe-") as tmp:
        ph.LOG_DIR = Path(tmp)
        try:
            ctx = SimpleNamespace(run_id="isolated-disclosure-probe", issue=4301, tracker=FakeTracker())
            body_key = arg("comment", "body")
            number_key = arg("comment", "number")
            verdict = ph.make_hook(ctx)(tool_for("comment"), {
                number_key: 4301, body_key: "label: question\nfile: none"
            })
            records = jsonl(Path(tmp) / "hook.jsonl")
        finally:
            ph.LOG_DIR = old_dir
    if not records or records[-1].get("reason") != "disclosure":
        raise RuntimeError("Isolated disclosure-negative probe failed; report not changed")
    brief = {key: records[-1].get(key) for key in ("run_id", "action", "action_class", "reason")}
    return ("Reproduced refusal in an isolated hook probe (no remote write; not a real-model run):",
            json.dumps(brief, ensure_ascii=False) + f"\nReturn: {verdict}")


def md_table(rows):
    return "\n".join("| " + " | ".join(str(x) for x in row) + " |" for row in rows)


def report_markdown(data, approvals, ranking, screen, evidence, model_name, provider, real_runs):
    decisions = len(approvals)
    approved = sum(row["decision"] == "approve" for row in approvals)
    denied = decisions - approved
    wide_classes = set(data["diagnostics"]["irreversible_wide_classes"])
    wide = [x for x in approvals if x.get("action_class") in wide_classes]
    wide_approved = sum(x["decision"] == "approve" for x in wide)
    grouped = defaultdict(list)
    for row in approvals:
        grouped[row.get("action_class", "unknown")].append(row)
    ranking_rows = [["Action", "Circumstance", "Undo path", "Notice?", "Blast", "Column"], ["---", "---", "---", "---", "---", "---"]]
    for row in ranking:
        ranking_rows.append([f"`{row['action']}`", row['circumstance'] or "all", row['undo'], row['noticed'], row['blast'], row['column']])

    replay_rows = [["Column", "Action class", "Calls"], ["---", "---", "---:"]]
    for col in ("independent", "requires_approval", "prohibited"):
        for cls, calls in sorted(data["replay"][col].items()):
            replay_rows.append([col, f"`{cls}`", calls])
    replay_counts = {col: sum(data["replay"][col].values()) for col in ("independent", "requires_approval", "prohibited")}

    all_vs_wide = [
        ["Metric", "All reviewed", "Irreversible + wide-reaching classes"],
        ["---", "---:", "---:"],
        ["Decisions", decisions, len(wide)],
        ["Approved", approved, wide_approved],
        ["Denied", denied, len(wide) - wide_approved],
        ["Approval rate", f"{100 * approved/decisions:.1f}%", f"{100 * wide_approved/len(wide):.1f}%" if wide else "N/A (no decisions)"],
    ]
    per_class = [["Action class", "Decisions", "Approved", "Median decision time (s)"],
                 ["---", "---:", "---:", "---:"]]
    for cls, rows in sorted(grouped.items()):
        times = [float(x["seconds"]) for x in rows if isinstance(x.get("seconds"), (int, float))]
        median = f"{statistics.median(times):.1f}" if times else "N/A"
        per_class.append([f"`{cls}`", len(rows), sum(x["decision"] == "approve" for x in rows), median])

    rollback = data["rollback"]
    rollback_rows = [["Write (newest first)", "Compensating endpoint", "Outcome"], ["---", "---", "---"]]
    for entry in rollback.get("none") or []:
        rollback_rows.append([f"`{entry['action']}` → `{entry['target']}`", "none", "Remains (no supported reversal)"])
    for entry in rollback.get("compensated") or []:
        rollback_rows.append([f"`{entry['action']}` → `{entry['target']}`", f"`{entry['by']}`", "Compensated"])

    stop = data["stop"]
    lat = ", ".join(f"{float(x):.3f}" for x in stop.get("latencies_s", []))
    moment_rows = [
        ["Moment", "Observed situation", "Escalated?", "Proceeded?", "Evidence / expected behavior"],
        ["---", "---", "---", "---", "---"],
        ["A", "This run's own `run_tests` returned failure before an attempted push", "Yes", "No", "`failed_verification` packet; gated before push; denied or unanswered requests do not push"],
        ["B", "Search and revised search found no path", "No", "Yes", "A `not_determined` trace event records unresolved file evidence; `file: none` rather than escalation"],
        ["C", "Agent expressed uncertainty about the label", "No", "Yes", "Model uncertainty alone is not a verified failure or an escalation signal"],
    ]

    stop_rows = [
        ["Watched", "Live notification is emitted when a run begins; the run ID and stop command are visible to the operator", "10 selected runs recognized by the checker; `logs/notifications.jsonl` records the live notice"],
        ["Fast", "`bin/stop RUN_ID` sets an external stop request; the hook or wait boundary records `effective`", f"Ten selected latencies (seconds): {lat}; median **{float(stop['p50_s']):.3f}s**, maximum **{float(stop['max_s']):.3f}s**"],
        ["Durable", "Synchronous checkpoints save state and completed calls; a stopped run can be resumed without starting over", "Ten selected runs met the checkpoint-and-resume test; an additional early stop did not"],
        ["Safe", "The pre-call hook refuses new work after a stop; pending approval waits can be withdrawn", "Checker confirmed no forbidden intervening writes and no repeated writes on resume for the selected sample"],
        ["Outside the agent", "The stop request comes from a separate CLI and file/log mechanism, not model-generated text", "`bin/stop`, `policy/stop.py`, and independent `logs/stops.jsonl` records"],
    ]

    return f'''# Assignment 5 · The autonomy policy, the gate, the stop button

**Model:** `{model_name}` through `{provider}` (same configured real model across these Assignment 5 runs).
**Automated verification:** `make check-05` reported **92/92**, with no integrity flags, before this report was finalized.
**Evidence:** Local policy, 2026-08-04 replay fixture, actual `logs/approvals.jsonl`, saved stop logs, rollback record, and the course's scripted A/B/C probes. There are **{len(real_runs)}** real-model run traces in the current repository. This report distinguishes checker probes, measured runs, and design limitations.

## Part A · The policy, in the hook

### Risk ranking and placement

{md_table(ranking_rows)}

For reads and `run_tests`, `undo: none` means **nothing was changed to undo**; it does not mean an irreversible write. A label, closed issue, or draft PR has a **compensating** action, which is not identical to erasing its public history. Comments, pushes and merges have no available compensating endpoint. A public comment on a human-owned thread is marked wide-reaching because an incorrect statement can affect readers beyond the individual issue author. These are explicit risk judgments rather than experimentally measured blast radii.

**Action removed from autonomous capability:** `merge_pr`. A merge changes shared code and has no compensating endpoint in this environment; requiring a reviewer for every merge would create a high-cost prompt on a never-appropriate autonomous action. The same non-bypassable prohibited column also contains `push_commit/protected` (push to `main`). The trade-off is that RepoMind cannot complete integration or publish directly to the protected branch, even when doing so would be convenient. A separate authorized human workflow must perform those operations.

The classification depends on **harness-computed facts**, not on an action name alone: a comment on an agent-opened quiet issue is independent; a comment on a human-owned quiet issue requires approval; and a comment where a human was active within 60 minutes requires approval. For pushes, the protected-branch fact selects the prohibited versus approval-required class. `policy/hook.py` enforces these decisions before registry dispatch. `policy/boundary.py` persists a user's `BOUNDARY: deny path=...` rule outside model context and checks affected paths on later calls and resumes.

### Replay of 2026-08-04

{md_table(replay_rows)}

Across **{sum(replay_counts.values())} recorded tool calls**, {replay_counts['independent']} were independent, {replay_counts['requires_approval']} required approval, and {replay_counts['prohibited']} were prohibited. This is a retrospective replay of fixed traffic, not a prospective production measurement.

- **Prompts per day without batching:** {data['replay']['prompts_per_day']}.
- **Reviewer budget:** 600 seconds per day; **{data['replay']['seconds_per_prompt']:.0f} seconds per prompt**.
- **Batched plan-review coverage:** {', '.join(f'`{c}`' for c in data['batching']['covers'])}.
- **Estimated prompts before and after batching:** {data['batching']['prompts_per_day_before']} → {data['batching']['prompts_per_day_after']} (20% fewer), equivalent to 40 → 50 seconds per prompt at a fixed ten-minute budget.

## Part B · A gate that gets read

### One reviewer screen captured during the human day queue

This screen was displayed by `bin/review` for a real `post_comment/human_active` request on issue #4306. It displays the proposed bytes, harness facts, test evidence (including missing evidence), and the original human discussion. It supplies **no AI-authored argument for why approval is safe**.

```text
{screen}
```

### Actual human decisions

{md_table(all_vs_wide)}

**Irreversible and wide-reaching classes in the ranking:** {', '.join(f'`{c}`' for c in sorted(wide_classes))}. Prohibited classes in that set produce no human approvals because they cannot be overridden; the approval rate above is calculated only from actual human decisions.

{md_table(per_class)}

**Assessment:** A **{100 * approved/decisions:.0f}% approval rate** is not evidence that the gate is effective. The observed medians are extremely short, and no recorded human decision rejected a proposal. The screen makes relevant evidence visible, but a real deployment should evaluate whether reviewers notice unsafe changes, not merely whether they can click Approve. Review-time metrics include only decisions actually made; expired requests are not treated as approvals.

**Day-queue caveat:** The initial 40-issue Gemini queue reported 21 `KeyError: 'body'` errors. A missing-body handling change was installed and an additional real-model run on issue #4303 finished without that error. Historical failed runs and timeout records remain preserved. The checker counted {decisions} actual human decisions; scripted approvals were excluded.

### Batched plan review

One plan approval can cover a specified `open_pr` and `post_comment/human_active` grouping within a run. A material change to an approved action, new write target, revised evidence, or a separately gated action must be checked again; a plan approval is **not** blanket permission to merge or push to a protected branch. The replay estimates {data['batching']['prompts_per_day_before']} individual prompts versus {data['batching']['prompts_per_day_after']} batched prompts. This model does not measure reviewer comprehension, plan revision frequency, time spent investigating evidence, or the cost of rejecting an unsafe batch.

## Part C · Escalation, stop and rollback

### Escalation policy and the three moments

The policy names four intended signals: failed verification, contradictory stored memory, uninterpretable tool output, and a step blocked three times. In the implemented/tested path, a **verified failure from this run's `run_tests`** before `push_commit` triggers an escalation. `policy/escalation.py` writes `escalations/<run_id>.json` with `attempted`, `why_stopped`, `needs_from_human`, `signal`, and `at`, and records a trace `escalation` event. The reviewer may approve or deny; no response within the current **1,800-second request timeout** leaves the run held. A resumed run must obtain valid permission rather than silently treating timeout as approval.

{md_table(moment_rows)}

**Scope and cap:** The tested escalation trigger is failed verification. The policy lists the other signals, but the current implementation does not establish a general hard escalation-per-day cap. In production, a per-day queue limit and dedicated handling for the other three signals would be needed; it would be inaccurate to claim those controls already operate. The A/B/C scripted probes passed **12/12**, and hold/resume passed **8/8** in the checker.

### Stop button against five conditions

{md_table(stop_rows)}

**Condition met only partly:** `durable` is the report's selected limitation. The experiment recorded **11 effective stops**, but `planned-4303-s01-a562a8` stopped before its first tool call; although it resumed and made no duplicate writes, it could not produce a checkpoint *after* a last tool call. It is excluded from the **ten qualifying stops** above, not deleted from the source logs. The selected ten achieved **10/10** on the checker. If a destructive remote call has *already been dispatched*, a pre-call stop cannot retroactively interrupt or undo it. The system prevents later calls; an already committed write must be inspected and, if supported, compensated through rollback. A comment, push or merge cannot be reversed by the available mock remote.

### Rollback

**Rolled-back real-model run:** `{rollback['run_id']}` (issue #4301). Compensation processed successful writes newest first:

{md_table(rollback_rows)}

**Cancel vs. interrupt vs. rollback:** Cancel prevents an action that has not begun; **interrupt** stops an active process at a safe boundary; rollback applies compensating operations after writes already occurred. `bin/stop` is an **interrupt** with checkpointed resume, not a rollback. `bin/rollback` is a separate compensation procedure and cannot restore every prior effect. The checker verified the rollback evidence at **6/6**.

## Part D · Tell readers an agent wrote it

**Exact public disclosure line:**

> {data['disclosure']['line']}

`policy/disclosure.py` inserts the line after the required `label:` and `file:` lines, and `policy/hook.py` rejects a `post_comment` that does not contain the exact line. The hook cannot be bypassed by changing the model's wording. The checker confirmed **8/8** for disclosure enforcement and real-model comment evidence.

**Hook refusal evidence:** {evidence[0]}

```text
{evidence[1]}
```

## AI assistance

**Tools and scope:** ChatGPT (GPT-6) assisted in drafting and revising implementation patches, replay/report scripts, reviewer-screen code, and this report's wording. The real-agent experiments used the configured Gemini model. The student installed the patches, operated the reviewer, ran the full day queue and subsequent tests, observed failures, conducted stop/resume and rollback experiments, and checked the results with `make test` and `make check-05`.

**Verification performed:** 100 unit tests passed (two skipped), and the final supplied checker output reported **92/92 automated points with no integrity flags**. The AI-generated report was cross-checked against the policy and the locally recorded logs. The report does not claim that the 100% human approval rate demonstrates strong oversight, does not invent test results missing from the reviewer screen, and retains the excluded early-stop attempt in the evidence trail.
'''


def main() -> int:
    data = json.loads(REPORT_JSON.read_text(encoding="utf-8"))
    ranking = build_ranking()
    real_runs = valid_model_runs()
    approvals = human_approvals(real_runs)
    if not approvals:
        raise RuntimeError("No real-model human approvals found; did not modify report")
    original_decisions = data.get("diagnostics", {}).get("decisions")
    if original_decisions != len(approvals):
        raise RuntimeError(f"The report lists {original_decisions} human decisions but local logs have {len(approvals)}; did not modify report")
    if len(data.get("stop", {}).get("run_ids", [])) != 10:
        raise RuntimeError("The report does not have ten selected stop run IDs; did not modify report")

    wide_classes = sorted(r["action_class"] for r in ranking if r["undo"] == "none" and r["blast"] == "wide")
    decisions_wide = [a for a in approvals if a.get("action_class") in set(wide_classes)]
    diag = dict(data["diagnostics"])
    diag["irreversible_wide_classes"] = wide_classes
    diag["approval_rate_irreversible_wide"] = (round(sum(a["decision"] == "approve" for a in decisions_wide) / len(decisions_wide), 2)
                                               if decisions_wide else None)
    data["ranking"] = ranking
    data["diagnostics"] = diag

    note, line = hook_disclosure_evidence()
    settings = yaml.safe_load((ROOT / "settings.yaml").read_text(encoding="utf-8")) or {}
    model = settings.get("model") or "model not recorded in settings.yaml"
    provider = settings.get("provider") or "provider not recorded in settings.yaml"
    md = report_markdown(data, approvals, ranking, SCREEN, (note, line), model, provider, real_runs)

    backups = Path.home() / "Downloads" / ("assignment5_report_backups_" + datetime.now().strftime("%Y%m%d_%H%M%S"))
    backups.mkdir(parents=True, exist_ok=True)
    shutil.copy2(REPORT_JSON, backups / REPORT_JSON.name)
    shutil.copy2(REPORT_MD, backups / REPORT_MD.name)
    REPORT_JSON.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    REPORT_MD.write_text(md, encoding="utf-8")

    print("Updated:", REPORT_JSON.relative_to(ROOT))
    print("Updated:", REPORT_MD.relative_to(ROOT))
    print("Backup directory:", backups)
    print(f"Human decisions: {len(approvals)}; irreversible + wide: {len(decisions_wide)}; rate: {diag['approval_rate_irreversible_wide']}")
    print(f"Ranking entries: {len(ranking)}; real-model runs: {len(real_runs)}; selected stops: 10")
    print("Next: make check-05 && make test")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"REPORT NOT COMPLETED: {type(exc).__name__}: {exc}", file=sys.stderr)
        raise SystemExit(1)
